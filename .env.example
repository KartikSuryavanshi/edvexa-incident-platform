DATABASE_URL=postgresql+psycopg://edvexa:edvexa@localhost:5432/edvexa
# Render may provide postgres:// or postgresql://; the backend normalizes both.
CORS_ORIGINS=http://localhost:5173
AI_API_KEY=
AUTH_TOKENS=viewer:generate-viewer-token,operator:generate-operator-token,admin:generate-admin-token
VITE_AUTH_TOKEN=generate-viewer-token
VITE_READ_ONLY=true
THRESHOLD_DEGRADED_LATENCY_MS=300
THRESHOLD_UNHEALTHY_LATENCY_MS=1000
THRESHOLD_DEGRADED_ERROR_RATE=0.05
THRESHOLD_UNHEALTHY_ERROR_RATE=0.20
THRESHOLD_DEGRADED_AVAILABILITY=0.995
THRESHOLD_UNHEALTHY_AVAILABILITY=0.95
RECOVERY_MAX_ATTEMPTS=3
RECOVERY_BACKOFF_SECONDS=0.05
